qmake: FORCE
	@$(QMAKE) -o Makefile aln-cli-qt.pro

qmake_all: FORCE


all: Makefile aln-cli-qt

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../aln-cpp-core/include/aln/alntypes.h ../aln-cpp-core/include/aln/frame.h ../aln-cpp-core/include/aln/channel.h ../aln-cpp-core/include/aln/localchannel.h ../aln-cpp-core/include/aln/packet.h ../aln-cpp-core/include/aln/parser.h ../aln-cpp-core/include/aln/router.h ../aln-cpp-core/include/aln/tcpchannel.h lambda_packet_handler.h test_router.h test_ping_service.h $(DISTDIR)/
