qmake: FORCE
	@$(QMAKE) -o Makefile aln-qt.pro

qmake_all: sub-aln-wrench-qt-aln-wrench-qt-pro-qmake_all sub-aln-cli-qt-aln-cli-pro-qmake_all FORCE

make_first: sub-aln-wrench-qt-aln-wrench-qt-pro-make_first sub-aln-cli-qt-aln-cli-pro-make_first  FORCE
all: sub-aln-wrench-qt-aln-wrench-qt-pro-all sub-aln-cli-qt-aln-cli-pro-all  FORCE
clean: sub-aln-wrench-qt-aln-wrench-qt-pro-clean sub-aln-cli-qt-aln-cli-pro-clean  FORCE
distclean: sub-aln-wrench-qt-aln-wrench-qt-pro-distclean sub-aln-cli-qt-aln-cli-pro-distclean  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-aln-wrench-qt-aln-wrench-qt-pro-install_subtargets sub-aln-cli-qt-aln-cli-pro-install_subtargets FORCE
uninstall_subtargets: sub-aln-wrench-qt-aln-wrench-qt-pro-uninstall_subtargets sub-aln-cli-qt-aln-cli-pro-uninstall_subtargets FORCE

xcodeproj:
	@$(QMAKE) -spec macx-xcode "$(EXPORT__PRO_FILE_)"

sub-aln-wrench-qt-aln-wrench-qt-pro-check:
	@test -d aln-wrench-qt/ || mkdir -p aln-wrench-qt/
	cd aln-wrench-qt/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/chadbohannan/workspace/application-layer-network/aln-qt/aln-wrench-qt/aln-wrench-qt.pro ) && $(MAKE) -f Makefile check
sub-aln-cli-qt-aln-cli-pro-check:
	@test -d aln-cli-qt/ || mkdir -p aln-cli-qt/
	cd aln-cli-qt/ && ( test -e Makefile.aln-cli || $(QMAKE) -o Makefile.aln-cli /Users/chadbohannan/workspace/application-layer-network/aln-qt/aln-cli-qt/aln-cli.pro ) && $(MAKE) -f Makefile.aln-cli check
check: sub-aln-wrench-qt-aln-wrench-qt-pro-check sub-aln-cli-qt-aln-cli-pro-check

sub-aln-wrench-qt-aln-wrench-qt-pro-benchmark:
	@test -d aln-wrench-qt/ || mkdir -p aln-wrench-qt/
	cd aln-wrench-qt/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/chadbohannan/workspace/application-layer-network/aln-qt/aln-wrench-qt/aln-wrench-qt.pro ) && $(MAKE) -f Makefile benchmark
sub-aln-cli-qt-aln-cli-pro-benchmark:
	@test -d aln-cli-qt/ || mkdir -p aln-cli-qt/
	cd aln-cli-qt/ && ( test -e Makefile.aln-cli || $(QMAKE) -o Makefile.aln-cli /Users/chadbohannan/workspace/application-layer-network/aln-qt/aln-cli-qt/aln-cli.pro ) && $(MAKE) -f Makefile.aln-cli benchmark
benchmark: sub-aln-wrench-qt-aln-wrench-qt-pro-benchmark sub-aln-cli-qt-aln-cli-pro-benchmark
